#!/usr/bin/env bash
#
# Install "mechabar" dependencies
#
# Author:  Jesse Mirabel <sejjymvm@gmail.com>
# Date:    August 22, 2025
# License: MIT

DEPENDENCIES=(
	bluez-utils
	brightnessctl
	fzf
	libnotify
	networkmanager
	otf-commit-mono-nerd
	pacman-contrib
	waybar
)

main() {
	printf "Installing dependencies...\n"

	local errors=0

	local package
	for package in "${DEPENDENCIES[@]}"; do
		if pacman -Qi "$package" &>/dev/null; then
			printf "[SKIP] %s" "$package\n"
		else
			printf "\n[    ] %s" "$package...\n"

			if sudo pacman -S --noconfirm "$package"; then
				printf "\n[DONE] %s" "$package\n"
			else
				printf "\n[ERR ] %s" "$package\n"

				((errors += 1))
			fi
		fi
	done

	printf "\nRestarting Waybar...\n"

	if ! (systemctl --user is-enabled waybar.service &&
		systemctl --user restart waybar.service) &>/dev/null; then
		pkill waybar
		waybar &>/dev/null &
		disown
	fi

	if ((errors > 0)); then
		printf "\nInstallation completed with %d errors.\n" "$errors"
		return 1
	fi

	printf "\nInstallation complete!\n"
}

main
