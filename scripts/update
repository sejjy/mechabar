#!/usr/bin/env bash
#
# Update Arch Linux packages
#
# Dependencies:
#   - libnotify (notify-send)
#   - pacman-contrib (checkupdates)
#
# Author:  Jesse Mirabel <sejjymvm@gmail.com>
# Date:    August 16, 2025
# License: MIT

TIMEOUT=10

GREEN=$'\e[32m'
BLUE=$'\e[34m'
RESET=$'\e[39m'

usage() {
	cat <<-EOF
		USAGE: ${0##*/} [option]

		Update Arch Linux packages

		OPTIONS:
		  module    Output Waybar module
		  <none>    Launch the CLI
	EOF
}

debug() { printf "%b" "$*" >&2; }

detect_helper() {
	local helper
	for helper in aura pakku paru pikaur trizen yay; do
		if command -v "$helper" >/dev/null; then
			HELPER=$helper
			break
		fi
	done
}

get_updates() {
	local packages status

	packages=$(timeout $TIMEOUT checkupdates)
	status=$?

	if ((status != 0 && status != 2)); then
		return 1
	fi

	UPDATES=$(grep -c . <<<"$packages")

	if [[ -n $HELPER ]]; then
		local aur_packages aur_status

		aur_packages=$(timeout "$TIMEOUT" "$HELPER" -Qua)
		aur_status=$?

		if ((aur_status != 0 && ${#aur_packages} > 0)); then
			return 1
		fi

		AUR_UPDATES=$(awk '!/\[ignored\]/ {print $1}' <<<"$aur_packages" |
			grep -c .)
	fi

	return 0
}

output_module() {
	local icon tooltip

	if ! get_updates; then
		icon='󰒑'
		tooltip="<b>Failed to fetch updates</b>"
		tooltip+="\nRight-click to retry"
	elif ((UPDATES + AUR_UPDATES > 0)); then
		icon='󰄠'
		tooltip="<b>Pacman</b>: $UPDATES"

		if [[ -n $HELPER ]]; then
			local padding
			printf -v padding "%*s" $((6 - ${#HELPER})) ''

			tooltip+="\n<b>${HELPER^}</b>: $padding$AUR_UPDATES"
		fi
	else
		icon='󰸟'
		tooltip="No updates available"
	fi

	cat <<-EOF
		{ "text": "$icon", "tooltip": "$tooltip" }
	EOF
}

update_packages() {
	debug "${BLUE}Updating packages...${RESET}\n"

	if [[ -n $HELPER ]]; then
		command $HELPER -Syu
	else
		sudo pacman -Syu
	fi

	notify-send "Update Complete" -i "package-install"

	debug "\n${GREEN}Update complete!${RESET}\n"
	read -rsn 1 -p "Press any key to exit..."
}

main() {
	case $1 in
		module)
			detect_helper
			output_module
			;;
		'')
			trap "pkill -RTMIN+1 waybar" EXIT

			detect_helper
			update_packages
			;;
		*)
			usage >&2
			return 1
			;;
	esac
}

main "$@"
