#!/usr/bin/env bash
#
# Adjust screen brightness
#
# Dependencies:
#   - brightnessctl
#   - libnotify (notify-send)
#
# Author:  Jesse Mirabel <sejjymvm@gmail.com>
# Date:    August 28, 2025
# License: MIT

VALUE=2

print_help() {
	local script=${0##*/}

	cat <<-EOF
		$script: $script <option> [value]
		    Adjust screen brightness

		    Options:
		      set       Set brightness to [value]%
		      up        Increase brightness by [value]% (default: +$VALUE%)
		      down      Decrease brightness by [value]% (default: -$VALUE%)
	EOF
}

get_brightness() {
	brightnessctl --machine-readable | awk -F ',' '{print $4}' | tr -d "%"
}

set_brightness() {
	local brightness=$1

	brightnessctl set "${brightness}%" >/dev/null

	notify-send "Brightness: ${brightness}%" --icon "contrast" \
		--hint "int:value:${brightness}" \
		--hint "string:x-canonical-private-synchronous:backlight"
}

main() {
	local option=$1
	local value=${2:-$VALUE}

	if ! [[ $value =~ ^[1-9][0-9]*$ ]]; then
		printf "%s: value must be an integer greater than 0\n" "${0##*/}" >&2
		return 1
	fi

	case $option in
		set)
			set_brightness "$value"
			;;
		up)
			local brightness
			brightness=$(get_brightness)

			set_brightness $((brightness + value))
			;;
		down)
			local brightness
			brightness=$(get_brightness)

			set_brightness $((brightness - value))
			;;
		*)
			print_help >&2
			return 1
			;;
	esac
}

main "$@"
