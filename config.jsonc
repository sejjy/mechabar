{
	"mode": "dock",
	"position": "top",
	"layer": "top",
	"width": 0,
	"height": 0,
	"margin": 0,
	"spacing": 0,
	"reload_style_on_change": true,

	"include": [
		"~/.config/waybar/modules/custom/*.jsonc",
		"~/.config/waybar/modules/hyprland/*.jsonc",
		// "~/.config/waybar/modules/optional/*.jsonc",
		"~/.config/waybar/modules/*.jsonc"
	],

	"modules-left": [
		"custom/user",

		"custom/left#bg-1",
		"hyprland/workspaces",
		"custom/right#bg-1",

		"hyprland/window"
	],

	"modules-center": [
		"hyprland/language",

		"custom/left#bg-1",
		"temperature",

		"custom/left#bg-2",
		"memory",

		"custom/left#bg-3",
		"cpu",
		"custom/left#inverse",

		"custom/left#accent",
		"custom/distro",
		"custom/right#accent",

		"custom/right#inverse",
		"idle_inhibitor",
		"clock#time",
		"custom/right#bg-3",

		"clock#date",
		"custom/right#bg-2",

		"network",
		"bluetooth",
		"custom/update",
		"custom/right#bg-1"
	],

	"modules-right": [
		"mpris",

		"custom/left#bg-1",
		"group/pulseaudio",

		"custom/left#bg-2",
		"backlight",

		"custom/left#bg-3",
		"battery",
		"custom/left#inverse",

		"custom/power"
	]
}
